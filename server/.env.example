# =============================================================================
# Planeja · API
# =============================================================================
# Copie para .env e preencha. O .env não vai para o Git.

# Servidor
NODE_ENV=development
PORT=3000

# -----------------------------------------------------------------------------
# Banco de dados · Supabase (PostgreSQL)
# -----------------------------------------------------------------------------
# No painel do Supabase: Project Settings > Database > Connection string >
# Transaction pooler (porta 6543). Troque [YOUR-PASSWORD] pela senha do banco.
DATABASE_URL=postgresql://postgres.SEU-PROJECT-REF:SUA-SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# JWT
JWT_SECRET=troque-por-uma-chave-de-no-minimo-32-caracteres
JWT_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
# Requisição nativa do Expo não manda Origin, mas o Expo Web manda.
CORS_ORIGIN=http://localhost:8081

# -----------------------------------------------------------------------------
# E-mail (recuperação de senha)
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Planeja <nao-responda@planeja.app>
