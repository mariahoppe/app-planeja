# =============================================================================
# Planeja · API
# =============================================================================
# Copie para .env e preencha. O .env não vai para o Git.

# Servidor
NODE_ENV=development
PORT=3000

# Produção (Render): confiar no proxy e subir o limite de requisições por IP
# (padrão 100 a cada 15 min). Em desenvolvimento, deixe comentado.
# TRUST_PROXY=1
# RATE_LIMIT_MAX=1000

# -----------------------------------------------------------------------------
# Banco de dados · Supabase (PostgreSQL)
# -----------------------------------------------------------------------------
# No painel do Supabase: Project Settings > Database > Connection string >
# Transaction pooler (porta 6543). Troque [YOUR-PASSWORD] pela senha do banco.
DATABASE_URL=postgresql://postgres.SEU-PROJECT-REF:SUA-SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# SSL da conexão com o banco (padrão: ligado). Use false só em redes que
# bloqueiam o Postgres com SSL, como o Wi-Fi da universidade.
# DB_SSL=false

# JWT
JWT_SECRET=troque-por-uma-chave-de-no-minimo-32-caracteres
JWT_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
# Requisição nativa do Expo não manda Origin, mas o Expo Web manda.
CORS_ORIGIN=http://localhost:8081

# -----------------------------------------------------------------------------
# Supabase Storage · limpeza das fotos das dicas
# -----------------------------------------------------------------------------
# Ao excluir uma foto ou uma dica, a API apaga o arquivo do bucket "dicas".
# Painel do Supabase: Project Settings > API. A service_role é SECRETA: fica só
# aqui no servidor, nunca no app. Sem elas, a exclusão funciona, mas o arquivo fica.
SUPABASE_URL=https://SEU-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# E-mail (recuperação de senha)
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Planeja <nao-responda@planeja.app>
