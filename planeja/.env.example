# Copie este arquivo para .env e ajuste os valores.
# O .env NÃO vai para o Git — cada integrante configura o seu.

# URL base da API (repositório separado, Node/Express).
# Em desenvolvimento, use o IP da sua máquina na rede local (não "localhost",
# pois o celular não alcança o localhost do computador). Ex.: http://192.168.0.10:3000
# Para a apresentação, use a URL da API publicada.
EXPO_PUBLIC_API_URL=http://192.168.0.10:3000

# Fotos das dicas (bucket "dicas" do Supabase Storage).
# No painel do Supabase: Project Settings > API > Project URL e a chave "anon public".
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
